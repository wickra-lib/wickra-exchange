# Keep everything configure stages or the compiler produces out of the R source
# tarball built by `R CMD build`. The package is source-distributed: configure
# fetches the C ABI at install time (or takes it from WKEX_INC / WKEX_LIB), so
# none of these belong in the distributable.
^src/wickra_exchange\.h$
^src/wickra_exchange\.dll$
^src/wickra_exchange\.def$
^src/libwickra_exchange\.dll\.a$
^src/libwickra_exchange\.(so|dylib)$
^src/wickra-exchange-c\.tar\.gz$
^src/wickra-exchange-c$
^src/Makevars$
^src/.*\.o$
^src/wickraexchange\.(dll|so|dylib)$
^src/symbols\.rds$
^src/dlltool\.log$
^\.gitignore$

# The golden corpus lives at the repository root, outside this package, so
# tests/golden.R only resolves when run from there -- which CI does explicitly.
# `R CMD check` runs everything under tests/ from the built tarball, where the
# corpus does not exist, so shipping this file fails the check that r-universe
# runs: v0.1.1 built 0 of 13 platform binaries, every one of them on
# `no golden/ directory found above ...`. The other test files build their own
# data and travel fine.
^tests/golden\.R$
