# Keep everything configure stages or the compiler produces out of the R source
# tarball built by `R CMD build`. The package is source-distributed: configure
# fetches the C ABI at install time (or takes it from WKEX_INC / WKEX_LIB), so
# none of these belong in the distributable.
^src/wickra_exchange\.h$
^src/wickra_exchange\.dll$
^src/wickra_exchange\.def$
^src/libwickra_exchange\.dll\.a$
^src/libwickra_exchange\.(so|dylib)$
^src/wickra-exchange-c\.tar\.gz$
^src/wickra-exchange-c$
^src/Makevars$
^src/.*\.o$
^src/wickraexchange\.(dll|so|dylib)$
^src/symbols\.rds$
^src/dlltool\.log$
^\.gitignore$
