# Link the import library built by configure.win, which references the staged
# wickra_exchange.dll. The C ABI header is staged into src/ by configure.win, so
# the include path is the source directory itself. install.libs.R bundles the
# DLL next to the package object, where the loader finds it.
PKG_CPPFLAGS = -I.
PKG_LIBS = libwickra_exchange.dll.a
